# Copy to a private local environment file; this template contains placeholders only.
EXASOL_HOST=<database-host>
EXASOL_PORT=<database-port>
EXASOL_API_USER=<dedicated-read-only-user>
EXASOL_API_PASSWORD=<secret-from-approved-store>
EXASOL_ENCRYPTION=true
EXASOL_VALIDATE_CERTIFICATE=true
# Optional SHA-256 certificate pin (64 hex characters). For local Exasol Personal
# with a self-signed certificate, set this to the fingerprint shown by DBeaver.
EXASOL_CERTIFICATE_FINGERPRINT=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
