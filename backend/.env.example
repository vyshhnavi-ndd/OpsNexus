# Copy to a private local environment file; this template contains placeholders only.
# Never commit credentials or the live .env file.

# Exasol Personal (OPS_STAGE staging schema browser)
EXASOL_HOST=127.0.0.1
EXASOL_PORT=8563
EXASOL_USER=<dedicated-staging-user>
EXASOL_PASSWORD=<secret-from-approved-store>
EXASOL_SCHEMA=OPS_STAGE
# EXASOL_NOCERTCHECK must be false; certificate validation is required.
EXASOL_NOCERTCHECK=false
# SHA-256 certificate fingerprint (64 hex characters). Obtain from DBeaver TLS error
# for local Exasol Personal with a self-signed certificate.
EXASOL_CERTIFICATE_FINGERPRINT=<64-hex-character-sha256-fingerprint>

# Flask server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FRONTEND_URL=http://localhost:5173

# Azure service principal (ADF pipeline history and cost management)
AZURE_TENANT_ID=<tenant-id>
AZURE_CLIENT_ID=<client-id>
AZURE_CLIENT_SECRET=<secret-from-approved-store>
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_RESOURCE_GROUP=opsnexus
AZURE_DATA_FACTORY=opsnexus

# Cost classification thresholds (INR)
AZURE_MONTHLY_BUDGET_INR=1000
COST_NORMAL_MAX_INR=10
COST_ELEVATED_MAX_INR=50

# Pipeline run classification thresholds
NORMAL_RUNS_MAX=5
ELEVATED_RUNS_MAX=20
